{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile of an app user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 250 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "displayName"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic or skill subject tracked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 20 },
        "goal_hours_per_week": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "name"]
    },
    "Session": {
      "title": "Session",
      "description": "Study session logged by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject_id": { "type": "string", "maxLength": 64 },
        "duration_min": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "subject_id", "duration_min", "date"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Daily habit tracked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "name"]
    },
    "Checkin": {
      "title": "Checkin",
      "description": "Habit completion status for a specific date",
      "type": "object",
      "properties": {
        "habit_id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["habit_id", "userId", "date", "completed"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed post with photo, reel video, or study document shared with circle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorPhoto": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["image", "video", "reel", "document"] },
        "mediaUrl": { "type": "string" },
        "fileName": { "type": "string", "maxLength": 150 },
        "caption": { "type": "string", "maxLength": 1000 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "authorName", "type", "createdAt"]
    },
    "ActiveStudySession": {
      "title": "ActiveStudySession",
      "description": "Real-time presence indicating a user currently in an active study session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "startedAt": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 200 }
      },
      "required": ["userId", "displayName", "startedAt"]
    },
    "StudyBuddy": {
      "title": "StudyBuddy",
      "description": "A study buddy connection in a user's circle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "buddyUserId": { "type": "string", "maxLength": 128 },
        "buddyName": { "type": "string", "maxLength": 100 },
        "buddyUsername": { "type": "string", "maxLength": 50 },
        "buddyPhotoURL": { "type": "string", "maxLength": 500 },
        "addedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "buddyUserId", "buddyName", "addedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing identity and public details"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "User's academic subjects"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "User's logged study sessions"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "User's daily habits"
    },
    "/users/{userId}/checkins/{checkinId}": {
      "schema": "Checkin",
      "description": "User's daily habit checkin logs"
    },
    "/users/{userId}/buddies/{buddyId}": {
      "schema": "StudyBuddy",
      "description": "User's study buddies and connections in their circle"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Shared posts, study reels, photos, and documents visible to the circle"
    },
    "/activeStudySessions/{userId}": {
      "schema": "ActiveStudySession",
      "description": "Live active study session indicator for circle members"
    }
  }
}
