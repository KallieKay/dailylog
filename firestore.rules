rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User Profile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 250));
    }

    // Validation for Subject
    function isValidSubject(data) {
      return data.id is string && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('color' in data) || (data.color is string && data.color.size() <= 20))
        && (!('goal_hours_per_week' in data) || (data.goal_hours_per_week is number && data.goal_hours_per_week >= 0));
    }

    // Validation for Session
    function isValidSession(data) {
      return data.id is string && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.subject_id is string && data.subject_id.size() <= 64
        && data.duration_min is number && data.duration_min > 0 && data.duration_min <= 1440
        && data.date is string && data.date.size() <= 20
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Validation for Habit
    function isValidHabit(data) {
      return data.id is string && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 20))
        && (!('active' in data) || data.active is bool);
    }

    // Validation for Checkin
    function isValidCheckin(data) {
      return data.habit_id is string && data.habit_id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.size() <= 20
        && data.completed is bool;
    }

    // Validation for Post
    function isValidPost(data) {
      return data.id is string && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && data.type in ['image', 'video', 'reel', 'document']
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 1000))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 150))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0))
        && (!('likedBy' in data) || data.likedBy is list);
    }

    // Validation for Active Study Session
    function isValidActiveSession(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.startedAt is string && data.startedAt.size() <= 50
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 200));
    }

    // Validation for Study Buddy
    function isValidBuddy(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.buddyUserId is string && data.buddyUserId.size() <= 128
        && data.buddyName is string && data.buddyName.size() > 0 && data.buddyName.size() <= 100
        && data.addedAt is string && data.addedAt.size() <= 50
        && (!('buddyUsername' in data) || (data.buddyUsername is string && data.buddyUsername.size() <= 50))
        && (!('buddyPhotoURL' in data) || (data.buddyPhotoURL is string && data.buddyPhotoURL.size() <= 500));
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming())
        && incoming().userId == existing().userId;
      allow delete: if false;

      // User's Subjects
      match /subjects/{subjectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming());
        allow update: if isOwner(userId) && isValidSubject(incoming())
          && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // User's Sessions
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(incoming());
        allow update: if isOwner(userId) && isValidSession(incoming())
          && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // User's Habits
      match /habits/{habitId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId) && isValidHabit(incoming());
        allow update: if isOwner(userId) && isValidHabit(incoming())
          && incoming().id == existing().id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // User's Checkins
      match /checkins/{checkinId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(checkinId) && isValidCheckin(incoming());
        allow update: if isOwner(userId) && isValidCheckin(incoming())
          && incoming().habit_id == existing().habit_id && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // User's Study Buddies
      match /buddies/{buddyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(buddyId) && isValidBuddy(incoming());
        allow update: if isOwner(userId) && isValidBuddy(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Community Circle Posts & Reels
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid && isValidPost(incoming()) && incoming().userId == existing().userId)
        || incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'likedBy'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Live Study Session Presence (Members currently studying)
    match /activeStudySessions/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidActiveSession(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
